# ==============================================================================
# ELGS — Ethereal Logistics Management System
# Environment Configuration Template (.env.example)
# ==============================================================================

# Server & Authentication
PORT=8080
RUST_LOG=enterprise_logistics_backend=info,tower_http=info
JWT_SECRET=elgs-enterprise-super-secure-jwt-secret-key-2026

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Session Pooler (recommended): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis Cache & Telematics Stream (Upstash Redis / Native Redis)
REDIS_URL=rediss://default:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379

# Frontend Public API Endpoint
PUBLIC_API_URL=http://localhost:8080/api/v1
