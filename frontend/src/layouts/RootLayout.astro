---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ELGS — Logistics Management System",
  description = "Modern distributed logistics management system with Astro 5, Ethereal UI, and Rust Axum backend."
} = Astro.props;

import '../styles/globals.css';
---

<!doctype html>
<html lang="en" class="dark" data-color-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Dynamic OKLCH Theme Injector Link -->
    <link id="ethereal-active-theme" rel="stylesheet" href="" />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen font-sans selection:bg-primary selection:text-primary-foreground">
    <slot />
  </body>
</html>
