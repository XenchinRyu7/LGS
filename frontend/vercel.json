{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": ".vercel/output",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/[...slug]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ]
}
