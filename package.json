{
  "name": "enterprise-logistics-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Logistics Management System (LMS) with Astro, Ethereal UI & Rust Backend",
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && cargo run",
    "dev:frontend": "cd frontend && pnpm dev",
    "build:backend": "cd backend && cargo build --release",
    "build:frontend": "cd frontend && pnpm build",
    "test:backend": "cd backend && cargo test",
    "test:frontend": "cd frontend && pnpm test",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "cd frontend && pnpm lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,json,md}": [
      "prettier --write"
    ],
    "backend/**/*.rs": [
      "cargo fmt --check --manifest-path backend/Cargo.toml"
    ]
  }
}
